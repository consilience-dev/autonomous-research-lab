agent/runtime/
agent/base/
agent/work/*
!agent/work/.gitkeep
owner/petri/
owner/verification/
**/__pycache__/

# Evaluation evidence stays local. Allowlist reusable implementation files.
!owner/petri/
owner/petri/*
!owner/petri/eval/
owner/petri/eval/*
!owner/petri/eval/budget.py
!owner/petri/eval/checkpoints.py
!owner/petri/eval/pilot.py
!owner/petri/eval/requirements.lock
!owner/petri/eval/rubric.json
!owner/petri/eval/smoke.py
!owner/petri/eval/summarize.py

# Local secrets, runtime environments, checkpoints, and registry lock.
.env
.env.*
*.pem
*.key
*.safetensors
*.gguf
.venv/
venv/
research/.registry.lock

# Owner-side checkpoints and model-selection evidence.
/owner/models/
/owner/model-selection/results/

!owner/petri/eval/qwen_pairs.py
!owner/petri/eval/run-qwen-pairs.zsh
!owner/petri/eval/summarize_qwen_pairs.py

# Run 2 contains an isolated, replaceable editor runtime and local outputs.
/agent-run2/base/
/agent-run2/runtime/
/agent-run2/work/*
!/agent-run2/work/.gitkeep
/owner/run2/private/
/owner/run2/runs/
/owner/run2/ready.json

# Owner-only mechanistic development inputs and outputs.
/owner/mech-001/inputs/
/owner/mech-001/results/
